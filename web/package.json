{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/api-types.gen.ts",
    "check:api": "openapi-typescript openapi.json -o src/api-types.gen.ts && git -C .. diff --exit-code -- web/openapi.json web/src/api-types.gen.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "streamdown": "^2.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^6.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

# /etc/openllmwiki/backup.env —— Litestream 与 restic 共用的凭据/参数模板。
#
# 安装（服务器上）：
#   sudo install -m 600 -o root -g root deploy/backup.env.example /etc/openllmwiki/backup.env
#   sudo editor /etc/openllmwiki/backup.env          # 把 CHANGE_ME 全换掉
# 引用它的单元：deploy/openllmwiki-litestream.service（EnvironmentFile=），以及
# restic 的 timer（DEPLOY §17 的片段）。改完重启对应服务即可。
#
# 格式是 systemd 的 EnvironmentFile，不是 shell 脚本：
#   - 一行一个 KEY=VALUE，值不要加引号；
#   - 行内不能跟注释（# 之后的内容会被算进值里），注释要单独占一行；
#   - 这里的环境变量会覆盖 litestream.yml 里同名 ${VAR} 的展开。
#
# 真凭据不许进 git。这个文件里只有 CHANGE_ME 占位。

# ---------------------------------------------------------------------------
# Litestream（只保 data/db.sqlite3）
# ---------------------------------------------------------------------------
LITESTREAM_BUCKET=CHANGE_ME-bucket
LITESTREAM_REGION=CHANGE_ME-region
# AWS 原生 S3 留空（并把 litestream.yml 里 endpoint / force-path-style 保持注释）；
# Cloudflare R2 / Backblaze B2 / MinIO 一类填 https://... 并把那两行取消注释。
LITESTREAM_ENDPOINT=
# R2 / MinIO / B2 一般填 true；AWS 原生 S3 填 false。
# 必须写 true/false（不是 0/1）：值会原样展开进 litestream.yml 再被 YAML 解析。
LITESTREAM_FORCE_PATH_STYLE=false
# Litestream 自动读取 AWS_*（也认 LITESTREAM_ACCESS_KEY_ID / LITESTREAM_SECRET_ACCESS_KEY）。
# 只给 Litestream 用的最小权限账户：对象存储那个 bucket 的读写即可。
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# restic（data/ 整目录：wiki git 仓库、uploads、extracted_text）
# ---------------------------------------------------------------------------
# 示例（AWS S3）：s3:https://s3.ap-northeast-1.amazonaws.com/CHANGE_ME-bucket/openllmwiki-restic
# 示例（R2）：    s3:https://CHANGE_ME-account.r2.cloudflarestorage.com/CHANGE_ME-bucket/openllmwiki-restic
RESTIC_REPOSITORY=s3:https://CHANGE_ME-endpoint/CHANGE_ME-bucket/openllmwiki-restic
# 仓库密码单独放文件（别写进这个 env）：sudo install -m 600 /dev/null /etc/openllmwiki/restic.password
# 然后 sudo editor /etc/openllmwiki/restic.password，填一个长随机串（`openssl rand -base64 32`）。
RESTIC_PASSWORD_FILE=/etc/openllmwiki/restic.password
# restic 的 --host 标签；恢复时按它挑快照。
BACKUP_HOST=openllmwiki
# 可选：备份源（默认 /opt/open_llm_wiki/data；本机演练可指到 /tmp/...）
# WIKI_DATA_DIR=/opt/open_llm_wiki/data
# 可选：额外排除项，空格分隔（data/backups 已默认排除）
# RESTIC_EXTRA_EXCLUDES=/opt/open_llm_wiki/data/node_modules
# 可选：给 restic 的 S3 凭据（与 Litestream 不同账户时另填；相同账户就复用上面的 AWS_*）
# RESTIC_REPOSITORY 里没有 region 时，restic 还需要：
# AWS_DEFAULT_REGION=ap-northeast-1

# ---------------------------------------------------------------------------
# 阿里云 OSS（Litestream 原生）
# ---------------------------------------------------------------------------
# Litestream 直接读 OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET；RAM 用户只给目标 bucket 读写。
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# restic + rclone（restic 无原生 OSS）
# ---------------------------------------------------------------------------
# 先把 deploy/rclone.conf.example 装成 /etc/openllmwiki/rclone.conf，然后仓库地址用 rclone: 前缀：
#   RESTIC_REPOSITORY=rclone:openllmwiki-oss:CHANGE_ME-bucket/openllmwiki-restic
#   RCLONE_CONFIG=/etc/openllmwiki/rclone.conf
# （如果以后换成支持 S3 的存储，再改回 s3:https://...）
RCLONE_CONFIG=/etc/openllmwiki/rclone.conf

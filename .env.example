# ============================================================================
# Open LLM Wiki environment template
#
# Copy to the repository root and fill in:
#     cp .env.example .env && chmod 600 .env
#
# .env is ignored by Git and must never be committed. No real secret belongs in
# this file.
#
# The application reads sections ①-③ and ⑥. Sections ④-⑤ are read only by the
# optional deployment/sync scripts; the app itself ignores them.
# ============================================================================


# ---- ① Site identity (app reads) -------------------------------------------
# Display name shown in the browser title and navigation lives in app.toml.
# Optional deployment override only; leave unset for normal deployments.
# SITE_NAME=
# Public base URL (scheme + host, no trailing slash). Required.
PUBLIC_BASE_URL=http://localhost:8000
# Runtime data: SQLite, uploads, extracted text, backups. Relative to repo root.
DATA_DIR=./data
# Optional: the wiki vault (a *separate* Git repository, often an Obsidian vault).
# Leave empty for DATA_DIR/wiki. The project repo does not track this path.
# WIKI_DIR=$HOME/Documents/Knowledge/my-wiki
# Optional: project-side application config. Leave empty for ./app.toml.
# WIKI_CONFIG=./app.toml
# Server-side auto git sync (default on). A vault without a remote skips it.
# WIKI_AUTO_SYNC=1
# WIKI_REMOTE=origin
# WIKI_BRANCH=main
# uvicorn bind/port. The app does not read these; deployment units and smoke
# scripts do.
BIND_HOST=127.0.0.1
PORT=8100
# Set to 1 once HTTPS is in place; keeps the session cookie HTTPS-only.
COOKIE_SECURE=0
# Session signing secret. Required. Generate a long random string.
SESSION_SECRET=change-me-to-a-long-random-string


# ---- ② Administrator (app reads; used by seed only) ------------------------
ADMIN_NAME=管理员
# 11-digit phone number used as the admin login.
ADMIN_PHONE=
# Initial admin password for `python -m app.cli seed`. Keep it out of Git.
ADMIN_PASSWORD=


# ---- ③ LLM provider (app reads) --------------------------------------------
# Any OpenAI-compatible endpoint works. DeepSeek is the default and the
# DEEPSEEK_* names are still accepted as aliases.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Model name, e.g. deepseek-flash or another chat-completions model.
LLM_MODEL=deepseek-flash
# disabled (default) | enabled. DeepSeek thinking requires echoing previous
# reasoning_content with tools; this harness does not store it, so keep disabled
# unless you know the upstream supports it.
LLM_THINKING=disabled


# ---- ④ Optional server deployment (scripts read; app ignores) ---------------
# SSH target: prefer ~/.ssh/config alias in WIKI_SSH_HOST, otherwise
# WIKI_SSH_USER@WIKI_SERVER_IP.
WIKI_SERVER_IP=
WIKI_SSH_HOST=
WIKI_SSH_PORT=22
WIKI_SSH_USER=ubuntu
WIKI_SSH_KEY=
WIKI_SERVER_DIR=/opt/open_llm_wiki
WIKI_SERVER_DOMAIN=


# ---- ⑤ Optional local Obsidian / sync (scripts read; app ignores) -----------
# A local Obsidian clone of the *wiki vault* (separate Git repo). The app's
# WIKI_DIR is the server-side vault; this is the developer's clone.
# WIKI_LOCAL_VAULT=$HOME/Documents/Knowledge/my-wiki
# Obsidian root that contains a notes/ directory, if your sync script uses it.
# WIKI_OBSIDIAN_VAULT=$HOME/Documents/Knowledge
# WIKI_GIT_URL=ssh://user@server/srv/git/my-wiki.git
# WIKI_PYTHON=/path/to/python
# WIKI_LOCAL_PYTHON=/path/to/project/.venv/bin/python  # rebuild local index preview


# ---- ⑥ Observability (optional; no network by default) ---------------------
# Leave empty to disable Sentry entirely.
# SENTRY_DSN=
# production (default) | development
# ENVIRONMENT=production
# CRITICAL | ERROR | WARNING | INFO (default) | DEBUG
# LOG_LEVEL=INFO
# RELEASE=
